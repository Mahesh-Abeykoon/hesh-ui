{
  "name": "hesh-ui",
  "version": "1.0.0",
  "description": "A high-performance React component library with polished defaults, token-driven theming, and built-in accessibility. Zero runtime dependencies beyond React.",
  "license": "MIT",
  "author": {
    "name": "Mahesh Abeykoon",
    "url": "https://github.com/Mahesh-Abeykoon"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mahesh-Abeykoon/hesh.git"
  },
  "bugs": {
    "url": "https://github.com/Mahesh-Abeykoon/hesh/issues"
  },
  "homepage": "https://github.com/Mahesh-Abeykoon/hesh#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/hesh.css",
    "./styles": "./dist/hesh.css",
    "./hesh.css": "./dist/hesh.css",
    "./dist/hesh.css": "./dist/hesh.css",
    "./dist/styles.css": "./dist/hesh.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "hesh-ui": "./bin/hesh.js",
    "hesh": "./bin/hesh.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build:registry": "node scripts/build-registry.mjs",
    "build": "npm run clean && vite build --mode lib && tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/build-registry.mjs",
    "build:docs": "vite build && node scripts/build-registry.mjs",
    "build:demo": "npm run build:docs",
    "build:html": "npm run build:docs && node scripts/bundle-html.mjs && node scripts/verify-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "test": "node scripts/smoke.mjs && node scripts/test-cli.mjs",
    "prepublishOnly": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "lint:unused": "node scripts/check-unused-imports.mjs",
    "check:unused": "node scripts/check-unused-imports.mjs",
    "lint:fix": "node scripts/fix-unused-imports.mjs",
    "fix:unused": "node scripts/fix-unused-imports.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sucrase": "^3.35.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "react",
    "components",
    "ui-library",
    "design-system",
    "accessible",
    "typescript",
    "tailwind-alternative"
  ],
  "engines": {
    "node": ">=18"
  }
}
